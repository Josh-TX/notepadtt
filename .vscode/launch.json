{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Delve)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frontend (Vite dev server)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Run notepadtt",
      "configurations": [
        "Backend (Delve)",
        "Frontend (Vite dev server)"
      ],
      "stopAll": true
    }
  ]
}
